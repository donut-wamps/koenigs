<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VKF Admin – Königs Versicherungen</title>
  <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>

<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: #0d1b2a;
  color: #f0ece4;
  font-family: Arial, sans-serif;
  min-height: 100vh;
}

/* LOGIN */
#login-screen {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
}

.login-box {
  background: #132130;
  border: 1px solid #1e3048;
  border-radius: 12px;
  padding: 2.5rem 2rem;
  width: 100%;
  max-width: 380px;
  text-align: center;
}

.crown { font-size: 2.5rem; margin-bottom: 1rem; }

.login-box h1 {
  font-family: Georgia, serif;
  color: #c9a84c;
  font-size: 1.4rem;
  margin-bottom: 0.25rem;
}

.login-box p {
  color: #b0a899;
  font-size: 0.85rem;
  margin-bottom: 1.75rem;
}

.login-box input[type="password"] {
  width: 100%;
  padding: 0.7rem 1rem;
  background: #0d1b2a;
  border: 1px solid #1e3048;
  border-radius: 8px;
  color: #f0ece4;
  font-size: 1rem;
  text-align: center;
  letter-spacing: 0.2em;
  margin-bottom: 0.75rem;
  outline: none;
}

.login-box input[type="password"]:focus {
  border-color: #c9a84c;
}

.btn-login {
  width: 100%;
  padding: 0.7rem;
  background: #c9a84c;
  color: #0d1b2a;
  border: none;
  border-radius: 8px;
  font-size: 0.95rem;
  font-weight: bold;
  cursor: pointer;
}

.btn-login:hover { background: #e0c06a; }

.divider {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin: 1.25rem 0;
  color: #5a5650;
  font-size: 0.78rem;
}

.divider::before, .divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #1e3048;
}

#google-btn-wrap { display: flex; justify-content: center; }

.login-error {
  color: #e05c5c;
  font-size: 0.82rem;
  margin-top: 0.75rem;
  display: none;
}

/* ADMIN */
#admin-screen { display: none; }

header {
  background: #132130;
  border-bottom: 1px solid #1e3048;
  padding: 1rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.brand-name {
  font-family: Georgia, serif;
  color: #c9a84c;
  font-size: 1.1rem;
}

.badge {
  background: #1e3048;
  color: #b0a899;
  font-size: 0.72rem;
  padding: 3px 10px;
  border-radius: 99px;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

#user-info { color: #b0a899; font-size: 0.82rem; }

.btn-logout {
  background: none;
  border: 1px solid #1e3048;
  color: #b0a899;
  padding: 6px 14px;
  border-radius: 8px;
  font-size: 0.82rem;
  cursor: pointer;
}

.btn-logout:hover { border-color: #e05c5c; color: #e05c5c; }

.main { padding: 2rem; max-width: 1100px; margin: 0 auto; }

/* STATS */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 2rem;
}

@media (max-width: 700px) {
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
}

.stat-card {
  background: #132130;
  border: 1px solid #1e3048;
  border-radius: 10px;
  padding: 1rem 1.25rem;
}

.stat-label { color: #b0a899; font-size: 0.78rem; margin-bottom: 0.4rem; }
.stat-value { color: #c9a84c; font-size: 1.6rem; font-family: Georgia, serif; }

/* CONTROLS */
.controls {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}

.btn {
  padding: 8px 18px;
  border-radius: 8px;
  font-size: 0.88rem;
  cursor: pointer;
  border: 1px solid #1e3048;
  background: #132130;
  color: #f0ece4;
}

.btn:hover { border-color: #c9a84c; color: #c9a84c; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }

.btn-primary {
  background: #c9a84c;
  border-color: #c9a84c;
  color: #0d1b2a;
  font-weight: bold;
}

.btn-primary:hover { background: #e0c06a; border-color: #e0c06a; color: #0d1b2a; }

.btn-danger { border-color: #e05c5c; color: #e05c5c; background: #132130; }
.btn-danger:hover { background: rgba(224,92,92,0.1); }

/* STATUS */
.status-bar {
  padding: 10px 16px;
  border-radius: 8px;
  font-size: 0.85rem;
  margin-bottom: 1.25rem;
  display: none;
}

.status-info    { background: rgba(201,168,76,0.15); border: 1px solid #c9a84c; color: #c9a84c; }
.status-success { background: rgba(111,207,111,0.15); border: 1px solid #6fcf6f; color: #6fcf6f; }
.status-error   { background: rgba(224,92,92,0.15); border: 1px solid #e05c5c; color: #e05c5c; }

/* TABLE */
.table-wrap {
  background: #132130;
  border: 1px solid #1e3048;
  border-radius: 10px;
  overflow-x: auto;
}

table { width: 100%; border-collapse: collapse; font-size: 0.85rem; min-width: 680px; }

thead tr { background: #1e3048; }

th {
  text-align: left;
  padding: 11px 14px;
  color: #b0a899;
  font-size: 0.75rem;
  font-weight: normal;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

td { padding: 11px 14px; border-bottom: 1px solid #1e3048; color: #f0ece4; }
tr:last-child td { border-bottom: none; }
tr:hover td { background: rgba(255,255,255,0.03); }

.badge-typ { display: inline-block; padding: 2px 10px; border-radius: 99px; font-size: 0.75rem; font-weight: bold; }
.b-auto       { background: rgba(55,138,221,0.2); color: #78c0ff; }
.b-haus       { background: rgba(99,153,34,0.2);  color: #a3d96b; }
.b-leben      { background: rgba(186,117,23,0.2); color: #f5c96a; }
.b-gesundheit { background: rgba(212,83,126,0.2); color: #f09ac0; }
.b-unbekannt  { background: rgba(176,168,153,0.15); color: #b0a899; }

.del-btn {
  background: none;
  border: none;
  color: #5a5650;
  cursor: pointer;
  font-size: 1rem;
  padding: 2px 6px;
  border-radius: 4px;
}

.del-btn:hover { color: #e05c5c; background: rgba(224,92,92,0.1); }

.empty-state { text-align: center; padding: 3.5rem 1rem; color: #b0a899; }
.empty-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }

.spinner {
  display: inline-block;
  width: 13px; height: 13px;
  border: 2px solid rgba(201,168,76,0.3);
  border-top-color: #c9a84c;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  vertical-align: middle;
  margin-right: 6px;
}

@keyframes spin { to { transform: rotate(360deg); } }

.footer {
  text-align: center;
  color: #5a5650;
  font-size: 0.75rem;
  margin-top: 2.5rem;
  padding-bottom: 2rem;
}
</style>

<!-- LOGIN -->
<div id="login-screen">
  <div class="login-box">
    <div class="crown">♛</div>
    <h1>Königs Versicherungen</h1>
    <p>Interner Bereich – nur für Mitarbeiter</p>

    <input type="password" id="pw-input" placeholder="Passwort"
           onkeydown="if(event.key==='Enter') loginPW()" />
    <button class="btn-login" onclick="loginPW()">Einloggen</button>

    <div class="divider">oder mit Google anmelden</div>

    <div id="google-btn-wrap"></div>

    <div class="login-error" id="login-error">Falsches Passwort.</div>
  </div>
</div>

<!-- ADMIN -->
<div id="admin-screen">
  <header>
    <div class="brand">
      <span class="brand-name">♛ VKF Admin</span>
      <span class="badge">Interner Bereich</span>
    </div>
    <div class="header-right">
      <span id="user-info"></span>
      <button class="btn-logout" onclick="logout()">Abmelden</button>
    </div>
  </header>

  <div class="main">

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Anfragen gesamt</div>
        <div class="stat-value" id="stat-total">0</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Ø Budget</div>
        <div class="stat-value" id="stat-avg">–</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Häufigste Versicherung</div>
        <div class="stat-value" id="stat-top" style="font-size:1rem;padding-top:8px">–</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Letzter Abruf</div>
        <div class="stat-value" id="stat-time" style="font-size:0.85rem;padding-top:8px;color:#b0a899">–</div>
      </div>
    </div>

    <div class="controls">
      <button class="btn btn-primary" id="btn-scan" onclick="scanEmails()">⟳ E-Mails abrufen</button>
      <button class="btn" id="btn-export" onclick="exportCSV()" disabled>↓ CSV herunterladen</button>
      <button class="btn btn-danger" id="btn-clear" onclick="clearAll()" disabled>✕ Leeren</button>
    </div>

    <div class="status-bar" id="status-bar"></div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Alter</th>
            <th>E-Mail</th>
            <th>Versicherung</th>
            <th>Budget</th>
            <th>Datum</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="table-body">
          <tr>
            <td colspan="7">
              <div class="empty-state">
                <div class="empty-icon">📭</div>
                Noch keine Daten – klick auf „E-Mails abrufen"
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="footer">Königs Versicherungen · Interner Bereich · Nur für autorisierte Mitarbeiter</div>

  </div>
</div>

<script>
var PASSWORD    = 'ADMIN';
var CLIENT_ID   = '373467087391-d1sld3ls39ph0nts8r8im10hv6hqumai.apps.googleusercontent.com';
var GMAIL_SCOPE = 'https://www.googleapis.com/auth/gmail.readonly';

var rows        = [];
var scanning    = false;
var accessToken = null;
var tokenClient = null;

/* Immer Login zeigen – egal ob #VKF oder nicht */
document.getElementById('login-screen').style.display = 'flex';

/* Google Identity Services initialisieren sobald geladen */
function initGoogle() {
  if (typeof google === 'undefined') {
    setTimeout(initGoogle, 200);
    return;
  }

  google.accounts.id.initialize({
    client_id: CLIENT_ID,
    callback: onGoogleLogin
  });

  google.accounts.id.renderButton(
    document.getElementById('google-btn-wrap'),
    { theme: 'filled_black', size: 'large', text: 'signin_with', shape: 'rectangular', width: 280 }
  );

  tokenClient = google.accounts.oauth2.initTokenClient({
    client_id: CLIENT_ID,
    scope: GMAIL_SCOPE,
    callback: onTokenReceived
  });
}

window.addEventListener('load', initGoogle);

function onGoogleLogin(response) {
  var parts   = response.credential.split('.');
  var payload = JSON.parse(atob(parts[1].replace(/-/g,'+').replace(/_/g,'/')));
  document.getElementById('user-info').textContent = payload.email;
  tokenClient.requestAccessToken({ prompt: 'consent' });
}

function onTokenReceived(tokenResponse) {
  if (tokenResponse.error) {
    showStatus('Google-Anmeldung fehlgeschlagen: ' + tokenResponse.error, 'error');
    return;
  }
  accessToken = tokenResponse.access_token;
  openAdmin();
}

function loginPW() {
  var val = document.getElementById('pw-input').value;
  if (val === PASSWORD) {
    document.getElementById('login-error').style.display = 'none';
    document.getElementById('user-info').textContent = 'Passwort-Login';
    openAdmin();
  } else {
    document.getElementById('login-error').style.display = 'block';
    document.getElementById('pw-input').value = '';
    document.getElementById('pw-input').focus();
  }
}

function openAdmin() {
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('admin-screen').style.display = 'block';
}

function logout() {
  accessToken = null;
  rows = [];
  renderTable();
  document.getElementById('status-bar').style.display = 'none';
  document.getElementById('admin-screen').style.display = 'none';
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('pw-input').value = '';
}

/* ── E-MAILS ABRUFEN ── */
async function scanEmails() {
  if (scanning) return;

  if (!accessToken) {
    showStatus('Bitte zuerst mit Google anmelden um E-Mails zu lesen.', 'error');
    return;
  }

  scanning = true;
  var btn = document.getElementById('btn-scan');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span>Wird abgerufen…';
  showStatus('Verbinde mit Gmail…', 'info');

  try {
    var listRes = await fetch(
      'https://gmail.googleapis.com/gmail/v1/users/me/messages?maxResults=30&q=subject%3AAnfrage+OR+subject%3AVersionsicherung+OR+subject%3AK%C3%B6nigs',
      { headers: { 'Authorization': 'Bearer ' + accessToken } }
    );
    var listData = await listRes.json();

    if (!listData.messages || listData.messages.length === 0) {
      showStatus('Keine passenden E-Mails gefunden.', 'info');
      return;
    }

    var newEntries = [];
    var existing   = new Set(rows.map(function(r) { return r.email + '|' + r.datum; }));

    for (var i = 0; i < Math.min(listData.messages.length, 20); i++) {
      var msgRes  = await fetch(
        'https://gmail.googleapis.com/gmail/v1/users/me/messages/' + listData.messages[i].id + '?format=full',
        { headers: { 'Authorization': 'Bearer ' + accessToken } }
      );
      var msgData = await msgRes.json();
      var entry   = parseEmail(msgData);
      if (!entry) continue;
      var key = entry.email + '|' + entry.datum;
      if (!existing.has(key)) {
        existing.add(key);
        newEntries.push(entry);
      }
    }

    rows = rows.concat(newEntries);

    if (newEntries.length === 0) {
      showStatus('Alle Anfragen bereits in der Tabelle.', 'info');
    } else {
      showStatus('✓ ' + newEntries.length + ' neue Anfrage(n) eingetragen.', 'success');
    }

    renderTable();

  } catch (err) {
    showStatus('Fehler: ' + err.message, 'error');
  } finally {
    scanning = false;
    btn.disabled = false;
    btn.innerHTML = '⟳ E-Mails abrufen';
  }
}

/* ── E-MAIL PARSEN ── */
function getBody(payload) {
  if (!payload) return '';
  if (payload.body && payload.body.data) {
    return atob(payload.body.data.replace(/-/g, '+').replace(/_/g, '/'));
  }
  if (payload.parts) {
    for (var i = 0; i < payload.parts.length; i++) {
      var t = getBody(payload.parts[i]);
      if (t) return t;
    }
  }
  return '';
}

function grab(text, patterns) {
  for (var i = 0; i < patterns.length; i++) {
    var m = text.match(patterns[i]);
    if (m && m[1]) return m[1].trim();
  }
  return '';
}

function parseEmail(msgData) {
  var headers = msgData.payload.headers || [];
  var subject = '';
  var date    = '';

  for (var i = 0; i < headers.length; i++) {
    if (headers[i].name === 'Subject') subject = headers[i].value;
    if (headers[i].name === 'Date')    date    = headers[i].value;
  }

  if (!/anfrage|versicherung|k.nigs/i.test(subject)) return null;

  var body = getBody(msgData.payload);
  var full = subject + '\n' + body;

  var name = grab(full, [
    /Name[:\s]+([^\n\r,<]+)/i,
    /Kunde[:\s]+([^\n\r,<]+)/i
  ]);

  var alter = grab(full, [
    /Alter[:\s]+(\d+)/i,
    /(\d+)\s*Jahre/i
  ]);

  var email = grab(full, [
    /E-Mail[:\s]+([\w.+-]+@[\w.-]+\.\w+)/i,
    /Email[:\s]+([\w.+-]+@[\w.-]+\.\w+)/i,
    /([\w.+-]+@[\w.-]+\.\w+)/
  ]);

  var versicherung = grab(full, [
    /Versicherung(?:styp)?[:\s]+(Auto|Haus|Leben|Gesundheit)/i,
    /\b(Auto|Haus|Leben|Gesundheit)versicherung\b/i,
    /versichern[:\s]+(Auto|Haus|Leben|Gesundheit)/i
  ]);

  var budget = grab(full, [
    /Budget[:\s]+(\d+)/i,
    /(\d+)\s*€/i,
    /(\d+)\s*Euro/i
  ]);

  var datum = '';
  try {
    var d = new Date(date);
    datum = d.toLocaleDateString('de-DE') + ' ' +
            d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
  } catch(e) { datum = date.slice(0, 16); }

  if (!name && !email) return null;

  return { name: name, alter: alter, email: email, versicherung: versicherung, budget: budget, datum: datum };
}

/* ── TABELLE ── */
function badge(v) {
  var map = { 'auto': 'b-auto', 'haus': 'b-haus', 'leben': 'b-leben', 'gesundheit': 'b-gesundheit' };
  var key = (v || '').toLowerCase().trim();
  var cls = map[key] || 'b-unbekannt';
  return '<span class="badge-typ ' + cls + '">' + (v || '?') + '</span>';
}

function renderTable() {
  var tbody     = document.getElementById('table-body');
  var exportBtn = document.getElementById('btn-export');
  var clearBtn  = document.getElementById('btn-clear');

  if (rows.length === 0) {
    tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><div class="empty-icon">📭</div>Noch keine Daten</div></td></tr>';
    exportBtn.disabled = true;
    clearBtn.disabled  = true;
    updateStats();
    return;
  }

  exportBtn.disabled = false;
  clearBtn.disabled  = false;

  var html = '';
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    html += '<tr>' +
      '<td>' + (r.name || '–') + '</td>' +
      '<td>' + (r.alter || '–') + '</td>' +
      '<td style="font-size:0.8rem;color:#b0a899">' + (r.email || '–') + '</td>' +
      '<td>' + badge(r.versicherung) + '</td>' +
      '<td>' + (r.budget ? r.budget + ' €' : '–') + '</td>' +
      '<td style="font-size:0.78rem;color:#b0a899">' + (r.datum || '–') + '</td>' +
      '<td><button class="del-btn" onclick="deleteRow(' + i + ')">✕</button></td>' +
      '</tr>';
  }
  tbody.innerHTML = html;
  updateStats();
}

function updateStats() {
  document.getElementById('stat-total').textContent = rows.length;

  var budgets = rows.map(function(r) { return parseFloat(r.budget); }).filter(function(n) { return !isNaN(n); });
  document.getElementById('stat-avg').textContent = budgets.length
    ? Math.round(budgets.reduce(function(a,b){return a+b;},0) / budgets.length) + '€' : '–';

  var counts = {};
  rows.forEach(function(r) {
    var v = r.versicherung || '?';
    counts[v] = (counts[v] || 0) + 1;
  });
  var top = Object.entries(counts).sort(function(a,b){return b[1]-a[1];})[0];
  document.getElementById('stat-top').textContent = top ? top[0] : '–';

  var now = new Date();
  document.getElementById('stat-time').textContent =
    now.toLocaleDateString('de-DE') + ' ' +
    now.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
}

function deleteRow(i) {
  if (!confirm('Eintrag löschen?')) return;
  rows.splice(i, 1);
  renderTable();
}

function clearAll() {
  if (!confirm('Alle Einträge löschen?')) return;
  rows = [];
  renderTable();
  document.getElementById('status-bar').style.display = 'none';
}

/* ── STATUS ── */
function showStatus(msg, type) {
  var bar = document.getElementById('status-bar');
  bar.textContent = msg;
  bar.className = 'status-bar status-' + type;
  bar.style.display = 'block';
}

/* ── CSV ── */
function exportCSV() {
  var lines = ['Name,Alter,E-Mail,Versicherung,Budget (€),Datum'];
  rows.forEach(function(r) {
    lines.push(
      [r.name, r.alter, r.email, r.versicherung, r.budget, r.datum]
        .map(function(v) { return '"' + (v||'').replace(/"/g,'""') + '"'; })
        .join(',')
    );
  });
  var blob = new Blob(['\uFEFF' + lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
  var url  = URL.createObjectURL(blob);
  var a    = document.createElement('a');
  a.href   = url;
  a.download = 'koenigs-anfragen.csv';
  a.click();
  URL.revokeObjectURL(url);
}
</script>

</body>
</html>
